<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Actual color scheme (light/dark/system) is driven
         from Kotlin (ui/theme/Theme.kt) via Compose Material3; this XML theme only
         sets the window background/status bar before Compose takes over, to avoid
         a white flash on cold start. -->
    <style name="Theme.StepBeatGo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:statusBarColor">@color/window_background_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>
</resources>
